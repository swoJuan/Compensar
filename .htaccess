# Compensar Design System — Apache config
Options -Indexes

# Charset y tipos MIME
AddDefaultCharset UTF-8
AddType text/html .html
AddType text/css .css
AddType application/javascript .js
AddType image/svg+xml .svg
AddType image/x-icon .ico
AddType font/woff2 .woff2
AddType font/woff .woff

# Cache para assets estáticos
<FilesMatch "\.(css|js|svg|woff2|woff|ico|png|jpg|jpeg)$">
  Header set Cache-Control "max-age=86400, public"
</FilesMatch>

# Sin cache para HTML (siempre la versión más reciente)
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>

# Comprimir texto
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain image/svg+xml
</IfModule>

# Permitir acceso a todos los archivos
<Files *>
  Order allow,deny
  Allow from all
</Files>
